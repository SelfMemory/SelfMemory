meta {
  name: Lint
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/knowledge/lint
  body: json
  auth: inherit
}

body:json {
  {}
}

tests {
  test("returns findings", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().findings).to.be.an("array");
  });
}

docs {
  Audits the knowledge base for decay: contradictions between pages,
  duplicates that should be merged, stale claims, orphans, and `[[links]]`
  pointing at pages that do not exist.

  Broken links are found deterministically; the rest costs one model call
  over every page, so this belongs on a schedule rather than in a request
  path. An empty `findings` array is the good result.

  Requires write permission — it audits the pages the caller can change.
}
