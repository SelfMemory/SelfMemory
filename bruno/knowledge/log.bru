meta {
  name: Log
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/knowledge/log?limit=20
  body: none
  auth: inherit
}

params:query {
  limit: 20
}

tests {
  test("returns operations newest first", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().entries).to.be.an("array");
  });
}

docs {
  Append-only record of what happened to this knowledge base: every ingest
  with the pages it created or updated, every lint pass.

  `ingest.noop` means a source was accepted but changed nothing — useful when
  a `Remember` call looks like it did nothing.
}
